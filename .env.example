# ===== REQUIRED =====
DATABASE_URL=postgresql://user:password@host:5432/radar
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
SESSION_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-another-long-random-secret
APP_SECRET=replace-with-a-third-long-random-secret

# ===== GEMINI-FIRST AI GATEWAY =====
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_STANDARD=gemini-3.8-flash
AI_MODEL_REASONING=gemini-3.8-flash
AI_TIMEOUT_MS=90000
AI_MAX_TOKENS=5000
RADAR_ENFORCE_AI_LIMITS=true
# Optional, only set after verifying current provider pricing.
AI_MODEL_PRICING_JSON={}
AI_INPUT_COST_PER_1M=0
AI_OUTPUT_COST_PER_1M=0

# Alternative providers remain supported.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01
AI_API_KEY=
AI_BASE_URL=

# ===== OPTIONAL EXTERNAL SEARCH =====
# Gemini can use native Google Search grounding without a separate search provider.
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# ===== INTELLIGENCE WORKER =====
WORKER_IDLE_MS=1500
MONITOR_BATCH_SIZE=20
MARKET_RESEARCH_INTERVAL_MINUTES=240
MARKET_RESEARCH_WORKSPACE_LIMIT=4
SNAPSHOT_RETENTION_DAYS=180

# ===== APP =====
APP_URL=http://localhost:3000

# ===== OPTIONAL NOTIFICATIONS =====
RESEND_API_KEY=
RADAR_FROM_EMAIL=RADAR <radar@example.com>
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# ===== OPTIONAL RAZORPAY (enable when payment plans are configured) =====
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_FOUNDER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_BUSINESS=
