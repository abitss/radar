# ===== REQUIRED =====
DATABASE_URL=postgresql://user:password@host:5432/radar
DATABASE_SSL=true
SESSION_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-another-long-random-secret
APP_SECRET=replace-with-a-third-long-random-secret

# ===== AI PROVIDER =====
# Option A: OpenAI (native web search + source citations)
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-5.6

# Option B: Anthropic (pair with one SEARCH_PROVIDER below for live web research)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_VERSION=2023-06-01
# AI_MODEL=your-claude-model

# Option C: Google Gemini (pair with one SEARCH_PROVIDER below for live web research)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_MODEL=gemini-3.7-flash

# Option D: Any OpenAI-compatible Chat Completions endpoint
# AI_PROVIDER=compatible
# AI_API_KEY=
# AI_BASE_URL=https://provider.example/v1
# AI_MODEL=your-model

# AI behavior
AI_TIMEOUT_MS=90000
AI_MAX_TOKENS=5000

# ===== WEB SEARCH =====
# Required for live web grounding when AI_PROVIDER is anthropic, gemini, or compatible.
# OpenAI mode uses its native web_search tool, so this is optional there.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
# SEARCH_PROVIDER=serper
SERPER_API_KEY=

# ===== APP / MONITORING =====
APP_URL=http://localhost:3000
MONITOR_BATCH_SIZE=20
MONITOR_INTERVAL_MS=300000
MARKET_RESEARCH_INTERVAL_MINUTES=240
MARKET_RESEARCH_WORKSPACE_LIMIT=4
SCAN_PAGE_LIMIT=6
SNAPSHOT_RETENTION_DAYS=180

# ===== OPTIONAL NOTIFICATIONS =====
RESEND_API_KEY=
RADAR_FROM_EMAIL=RADAR <radar@example.com>
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
