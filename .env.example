# RADAR production environment template. Never commit real secrets.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Zero-cost AI router
AI_PROVIDER=free-auto
FREE_AI_PROVIDER_ORDER=groq,cloudflare,gemini,openrouter
AI_TIMEOUT_MS=90000

# Groq Free
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STANDARD=openai/gpt-oss-120b
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_WEB=groq/compound

# Cloudflare Workers AI Free
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL_FAST=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_MODEL_STANDARD=@cf/nvidia/nemotron-3-120b-a12b
CLOUDFLARE_MODEL_REASONING=@cf/nvidia/nemotron-3-120b-a12b

# Existing Gemini remains a fallback
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_STANDARD=gemini-3.8-flash
AI_MODEL_REASONING=gemini-3.8-flash

# OpenRouter Free emergency fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional external search grounding. If absent, providers with native web search are used.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Worker
WORKER_IDLE_MS=1500
MONITOR_BATCH_SIZE=20

# App
APP_URL=https://radar-web-ulf8.onrender.com
APP_SECRET=
