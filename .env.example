# RADAR production environment template. Never commit real secrets.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Zero-cost AI stack
AI_PROVIDER=free-auto
FREE_AI_PROVIDER_ORDER=openrouter
AI_TIMEOUT_MS=90000

# OpenRouter Free reasoning
OPENROUTER_API_KEY=
OPENROUTER_MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_STANDARD=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_FAST=openai/gpt-oss-120b:free
OPENROUTER_MODEL_FALLBACK=openai/gpt-oss-120b:free
OPENROUTER_USE_FREE_ROUTER=true

# Free live-web grounding. Tavily is recommended and currently offers a free tier.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_TIMEOUT_MS=30000

# Optional alternative search providers
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Optional providers kept only for future use. They are ignored unless added to FREE_AI_PROVIDER_ORDER.
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GEMINI_API_KEY=

# Worker
WORKER_IDLE_MS=1500
MONITOR_BATCH_SIZE=20

# App
APP_URL=https://radar-web-ulf8.onrender.com
APP_SECRET=
